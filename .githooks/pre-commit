#!/bin/sh
# Refuse to commit while the card list has drifted (stale cards.js, schema
# problems, or a card sheet that stops printing the whole list), or while the
# rulebook has changed without a higher Rules version.
# The orphan `pr-media` branch holds only images, so there is no card list to check.
[ -f tools/cards.mjs ] || exit 0
node tools/cards.mjs check || exit 1
exec node tools/check-rules-version.mjs --staged
