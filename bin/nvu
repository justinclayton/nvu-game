#!/bin/sh
# North vs Up in a terminal. The same rules engine as the web game.
#
#   bin/nvu play new --seed 7           start a run, one named move at a time
#   bin/nvu play flip                   flip the room and draw
#   bin/nvu play card Red Charge     play a card, named
#   bin/nvu play undo                   undo back to the last checkpoint
#   bin/nvu play note "text"            write a note into the log
#   bin/nvu play show                   print the table and the open moves
#   bin/nvu card "Charge"            print a card's or Room's face, no run needed
#   bin/nvu replay runs/7.json          replay a run file and print its transcript
#   bin/nvu fuzz --seeds 50             random legal play, failures only
#   bin/nvu web                         the web game's dev server
#   bin/nvu revision                    the kit revision, R29.C43-v1
#   bin/nvu help                        the full grammar
#
# Installs app/node_modules on first use and regenerates the card modules if
# cards.yaml has changed, so a fresh clone can run it straight away.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
tsx="$root/app/node_modules/.bin/tsx"
# Not just "does node_modules exist" — a checkout from before this launcher
# added tsx can have node_modules without it, and would otherwise never
# reinstall.
[ -x "$tsx" ] || (cd "$root/app" && npm ci --silent)
make -s -C "$root" build

# The kit revision stamps the run file and the first line of a new run. Its
# engine count comes from git, so it is read here, outside the engine.
NVU_KIT_REVISION=$(sh "$root/tools/kit-revision.sh")
export NVU_KIT_REVISION

if [ "$1" = "revision" ]; then
  echo "$NVU_KIT_REVISION"
  exit 0
fi

if [ "$1" = "web" ]; then
  cd "$root/app" && exec npm run dev
fi

exec "$tsx" --tsconfig "$root/app/tsconfig.json" "$root/app/src/cli/main.ts" "$@"
