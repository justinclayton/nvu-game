#!/bin/sh
# North vs Up in a terminal. The same rules engine as the web game.
#
#   bin/nvu play new --seed 7           start a run, one numbered move at a time
#   bin/nvu play move 1                 make move 1
#   bin/nvu play undo                   undo back to the last checkpoint
#   bin/nvu play note "text"            write a note into the log
#   bin/nvu play show                   print the table and the legal moves
#   bin/nvu replay runs/7.json          replay a run file and print its transcript
#   bin/nvu fuzz --seeds 50             random legal play, failures only
#   bin/nvu web                         the web game's dev server
#   bin/nvu help
#
# Installs app/node_modules on first use and regenerates the card modules if
# design/cards.yaml has changed, so a fresh clone can run it straight away.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
tsx="$root/app/node_modules/.bin/tsx"
# Not just "does node_modules exist" — a checkout from before this launcher
# added tsx can have node_modules without it, and would otherwise never
# reinstall.
[ -x "$tsx" ] || (cd "$root/app" && npm install --silent)
make -s -C "$root" build

if [ "$1" = "web" ]; then
  cd "$root/app" && exec npm run dev
fi

exec "$tsx" --tsconfig "$root/app/tsconfig.json" "$root/app/src/cli/main.ts" "$@"
